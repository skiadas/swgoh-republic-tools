# Copy to .env and fill in (see deploy/DEPLOY.md)
SWGOH_ADMIN_TOKEN=change-me
SWGOH_APP_SECRET=change-me
SWGOH_ADMIN_DISCORD_ID=
SITE_DOMAIN=localhost
SWGOH_IMAGE_TAG=latest
# Optional: absolute host path of the compose project dir (Diun mounts it to
# run `docker compose`). Defaults to the project directory.
#SWGOH_APP_DIR=/home/ubuntu/swgoh-reviewer
SWGOH_DISCORD_CLIENT_ID=
SWGOH_DISCORD_CLIENT_SECRET=
SWGOH_DISCORD_REDIRECT=
SWGOH_NIGHTLY=1
SWGOH_REFRESH_HOUR=4
